# Required for text generation and RAG query rewriting
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_LLM_MODEL=deepseek-v4-flash

# Optional: required only for visual operation review
DASHSCOPE_API_KEY=
QWEN_API_KEY=
QWEN_VL_MODEL=qwen3-vl-plus

# Optional CNC.js integration
CNCJS_SIMULATION_API_BASE_URL=http://127.0.0.1:8000
CNCJS_SIMULATION_API_TOKEN=

# Optional RAG tuning; defaults point to agent/rag/storage/local_kb
RAG_TOP_K=8
RAG_MIN_SCORE=0.05
RAG_MAX_PDF_PAGES=0
RAG_ADDITIONAL_SOURCE_DIRS=
